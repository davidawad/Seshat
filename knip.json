{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["e2e/*.mjs", "scripts/*.ts"],
  "project": ["src/**/*.{ts,tsx}", "vite-plugins/**/*.ts", "scripts/*.ts", "e2e/*.mjs"],
  "ignoreDependencies": [
    // Consumed via CSS `@import` in src/styles/fonts.css, not a JS import —
    // knip only sees the latter.
    "@fontsource/atkinson-hyperlegible",
    "@fontsource/fraunces",
    "@fontsource/ibm-plex-mono",
    "@fontsource/inter",
    "@fontsource/newsreader",
    "@fontsource/source-serif-4",
    // MathJax's glyph tables are loaded on demand through `import.meta.glob` in
    // src/lib/math/render.ts, a path string rather than an import specifier.
    "@mathjax/mathjax-newcm-font"
  ]
}
