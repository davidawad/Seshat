{
  "name": "seshat",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "preview": "vite preview",
    "knip": "knip",
    "duplication": "jscpd --config .jscpd.json",
    "circular": "madge --circular --extensions ts,tsx src",
    "license": "license-checker-rseidelsohn --failOn 'GPL;AGPL' --excludePackages 'seshat@0.0.0' --summary",
    "audit": "pnpm audit",
    "size": "size-limit",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run circular && pnpm run duplication && pnpm run license && pnpm run test:coverage && pnpm run build && pnpm run size",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "ts-fsrs": "^5.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@size-limit/file": "^13.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "jsdom": "^30.0.0",
    "knip": "^6.29.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "lint-staged": "^17.2.0",
    "madge": "^8.0.0",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
